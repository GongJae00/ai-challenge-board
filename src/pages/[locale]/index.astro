---
import type { GetStaticPaths } from "astro"
import { getCollection } from "astro:content"

import ListingsView from "@/components/listings-view"
import { locales, type Locale } from "@/i18n/locales"
import { t } from "@/i18n/messages"
import Layout from "@/layouts/main.astro"
import { mergeDuplicates } from "@/lib/duplicates"

export const getStaticPaths = (() =>
  locales.map((locale) => ({
    params: { locale },
    props: { locale },
  }))) satisfies GetStaticPaths

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const listings = mergeDuplicates(
  (await getCollection("sources")).flatMap((source) => source.data.listings)
)
const builtAt = new Date().toISOString()
---

<Layout locale={locale}>
  <h1 class="mt-8 text-2xl font-semibold tracking-tight">
    {t(locale, "home.heading")}
  </h1>
  <ListingsView
    client:load
    listings={listings}
    locale={locale}
    builtAt={builtAt}
  />
</Layout>
