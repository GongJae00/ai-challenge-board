---
import { getRelativeLocaleUrl } from "astro:i18n"

import "@/styles/global.css"
import LanguageMenu from "@/components/language-menu"
import SiteFooter from "@/components/site-footer.astro"
import { localeNames, locales, type Locale } from "@/i18n/locales"
import { t } from "@/i18n/messages"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const languages = locales.map((option) => ({
  locale: option,
  name: localeNames[option],
  href: getRelativeLocaleUrl(option),
}))
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content={t(locale, "site.description")} />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL}favicon.svg`}
    />
    <title>{t(locale, "site.name")}</title>
    <slot name="head" />
  </head>
  <body class="min-h-svh">
    <header class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
      <a href={getRelativeLocaleUrl(locale)} class="font-semibold">
        {t(locale, "site.name")}
      </a>
      <LanguageMenu
        client:load
        current={locale}
        label={t(locale, "nav.language")}
        options={languages}
      />
    </header>
    <main class="mx-auto max-w-6xl px-4 pb-16">
      <slot />
    </main>
    <SiteFooter locale={locale} />
  </body>
</html>
