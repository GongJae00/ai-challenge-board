{
  "claudeMdExcludes": [
    "**/.claude/rules/research.md",
    "**/.claude/rules/code.md",
    "**/.claude/rules/discovery.md",
    "**/.claude/rules/papers.md"
  ],
  "skillOverrides": {
    "research-sprint": "off",
    "research-program": "off",
    "paper-writing": "off",
    "experiment-loop": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/user-scope-guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
